{
  "name": "token-counter",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "ms-python.python"
      ]
    }
  },
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--security-opt",
    "seccomp=unconfined"
  ]
}